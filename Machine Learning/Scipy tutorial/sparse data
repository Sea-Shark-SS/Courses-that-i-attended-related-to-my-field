se 2D CSR matrix\n","csr_matrix_2d = csr_matrix(sharat_array_2d)\n","\n","# Method A: Extracting only the non-zero data values using '.data' [00:18:17]\n","print(\"1. Extracted Useful Data Only (.data):\")\n","print(csr_matrix_2d.data)\n","\n","# Method B: Counting total non-zero elements using '.count_nonzero()' [00:20:35]\n","print(f\"\\n2. Count of Non-Zero Elements: {csr_matrix_2d.count_nonzero()}\")\n","\n","\n","# =====================================================================\n","# STEP 4: ADVANCED SPARSE MATRIX MANIPULATIONS [00:22:18]\n","# =====================================================================\n","print(\"\\n\" + \"=\"*60)\n","print(\"--- SECTION 3: ADVANCED SPARSE METHODS ---\")\n","\n","# Duplicate an active matrix copy to show physical zero elimination [00:23:41]\n","csr_elim = csr_matrix(sharat_array_2d)\n","# Eliminate zero entries structurally from the sparse format [00:24:11]\n","csr_elim.eliminate_zeros()\n","print(\"1. Matrix After Running .eliminate_zeros():\")\n","print(csr_elim)\n","\n","# Clean and sum up redundant duplicate index entries [00:27:11]\n","csr_dup = csr_matrix(sharat_array_2d)\n","csr_dup.sum_duplicates()\n","print(\"\\n2. Matrix After Running .sum_duplicates():\")\n","print(csr_dup)\n","\n","# Convert our CSR (Row format) matrix into a CSC (Column format) matrix using '.tocsc()' [00:28:17]\n","csc_converted = csr_matrix_2d.tocsc()\n","print(\"\\n3. Converted Matrix Format (CSR -> CSC via .tocsc()):\")\n","print(csc_converted)\n","\n","print(\"\\n\" + \"=\"*60)\n","print(\"Sparse Matrix Operations Successfully Executed in Colab Space.\")\n","print(\"=\"*60)"]}]}