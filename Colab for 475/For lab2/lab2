 pd\n","from sklearn.ensemble import AdaBoostRegressor\n","from sklearn.metrics import mean_squared_error\n","from sklearn.model_selection import (\n","    train_test_split,\n","    KFold,\n","    StratifiedKFold,\n","    RepeatedKFold,\n","    RepeatedStratifiedKFold,\n","    LeaveOneOut,\n","    LeavePOut,\n","    ShuffleSplit,\n","    StratifiedShuffleSplit,\n","    GroupKFold,\n","    StratifiedGroupKFold\n",")\n","\n","# ==============================================================================\n","# 1. LOAD DATASET FROM CSV\n","# ==============================================================================\n","# Replace 'complete_dataset.csv' with your specific filename/path if necessary\n","csv_file_path = 'synthetic_numeric_dataset.csv'\n","\n","try:\n","    df = pd.read_csv(csv_file_path)\n","    print(\"=\" * 80)\n","    print(f\"Successfully loaded dataset: {csv_file_path} | Shape: {df.shape}\")\n","    print(\"=\" * 80 + \"\\n\")\n","except FileNotFoundError:\n","    raise FileNotFoundError(f\"Could not find the file '{csv_file_path}'. Please check the path.\")\n","\n","# Dynamically split features and target (Assuming the LAST column is the target)\n","X = df.iloc[:, :-1]\n","y = df.iloc[:, -1]\n","\n","# Strategy for Stratification: Bin the continuous target into quantiles\n","# 'duplicates='drop'' handles cases where target values are heavily uniform\n","y_bins = pd.qcut(y, q=5, labels=False, duplicates='drop')\n","\n","# Strategy for Group Validation: Create a synthetic Group ID array across your rows\n","# This ensures that GroupKFold and StratifiedGroupKFold execute cleanly without error\n","n_groups = 10\n","groups = np.repeat(np.arange(n_groups), len(df) // n_groups + 1)[:len(df)]\n","\n","# Initialize the AdaBoost Regressor\n","model = AdaBoostRegressor(random_state=42, n_estimators=50)\n","\n","\n","# ==============================================================================\n","# PART A: HOLD-OUT SPLITTING TECHNIQUES\n","# ==============================================================================\n","print(\"--- PART A: HOLD-OUT VARIATIONS ---\")\n","\n","# 1 \u0026 2 \u0026 3. Two-Way Shuffled/Random Hold-Out (80:20 Split)\n","X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.20, random_state=42, shuffle=True)\n","model.fit(X_train, y_train)\n","print(f\"[1,2,3] Two-Way Shuffled/Random Hold-Out MSE : {mean_squared_error(y_test, model.predict(X_test)):.4f}\")\n","\n","# 4. Three-Way Hold-Out (60:20:20 Split)\n","X_temp, X_test3, y_temp, y_test3 = train_test_split(X, y, test_size=0.20, random_state=42)\n","X_train3, X_val3, y_train3, y_val3 = train_test_split(X_temp, y_temp, test_size=0.25, random_state=42) # 0.25 * 0.80 = 0.20\n","model.fit(X_train3, y_train3)\n","print(f\"[4] Three-Way Hold-Out -\u003e Validation MSE       : {mean_squared_error(y_val3, model.predict(X_val3)):.4f}\")\n","print(f\"    Three-Way Hold-Out -\u003e Test MSE             : {mean_squared_error(y_test3, model.predict(X_test3)):.4f}\")\n","\n","# 5. Stratified Two-Way Hold-Out\n","X_train_s, X_test_s, y_train_s, y_test_s = train_test_split(X, y, test_size=0.20, random_state=42, stratify=y_bins)\n","model.fit(X_train_s, y_train_s)\n","print(f\"[5] Stratified Two-Way Hold-Out MSE          : {mean_squared_error(y_test_s, model.predict(X_test_s)):.4f}\")\n","\n","# 6. Stratified Three-Way Hold-Out\n","X_temp_s, X_test3_s, y_temp_s, y_test3_s = train_test_split(X, y, test_size=0.20, random_state=42, stratify=y_bins)\n","temp_bins = pd.qcut(y_temp_s, q=4, labels=False, duplicates='drop') # Re-stratify inside training pool\n","X_train3_s, X_val3_s, y_train3_s, y_val3_s = train_test_split(X_temp_s, y_temp_s, test_size=0.25, random_state=42, stratify=temp_bins)\n","model.fit(X_train3_s, y_train3_s)\n","print(f\"[6] Stratified Three-Way -\u003e Validation MSE     : {mean_squared_error(y_val3_s, model.predict(X_val3_s)):.4f}\")\n","print(f\"    Stratified Three-Way -\u003e Test MSE           : {mean_squared_error(y_test3_s, model.predict(X_test3_s)):.4f}\\n\")\n","\n","\n","# ==============================================================================\n","# PART B: CROSS-VALIDATION SPLITTING TECHNIQUES\n","# ==============================================================================\n","print(\"--- PART B: CROSS-VALIDATION VARIATIONS ---\")\n","\n","# 7. K-Fold Cross Validation (Standard)\n","kf = KFold(n_splits=5, shuffle=True, random_state=42)\n","kf_scores = []\n","for train_idx, val_idx in kf.split(X):\n","    model.fit(X.iloc[train_idx], y.iloc[train_idx])\n","    kf_scores.append(mean_squared_error(y.iloc[val_idx], model.predict(X.iloc[val_idx])))\n","print(f\"[1] Standard 5-Fold CV Mean MSE              : {np.mean(kf_scores):.4f}\")\n","\n","# 8. Stratified K-Fold Cross Validation\n","skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n","skf_scores = []\n","for train_idx, val_idx in skf.split(X, y_bins):\n","    model.fit(X.iloc[train_idx], y.iloc[train_idx])\n","    skf_scores.append(mean_squared_error(y.iloc[val_idx], model.predict(X.iloc[val_idx])))\n","print(f\"[2] Stratified 5-Fold CV Mean MSE            : {np.mean(skf_scores):.4f}\")\n","\n","# 9. Repeated K-Fold Cross Validation\n","rkf = RepeatedKFold(n_splits=5, n_repeats=3, random_state=42)\n","rkf_scores = []\n","for train_idx, val_idx in rkf.split(X):\n","    model.fit(X.iloc[train_idx], y.iloc[train_idx])\n","    rkf_scores.append(mean_squared_error(y.iloc[val_idx], model.predict(X.iloc[val_idx])))\n","print(f\"[3] Repeated K-Fold CV (5 Folds x 3 Reps) MSE : {np.mean(rkf_scores):.4f}\")\n","\n","# 10. Repeated Stratified K-Fold Cross Validation\n","rskf = RepeatedStratifiedKFold(n_splits=5, n_repeats=3, random_state=42)\n","rskf_scores = []\n","for train_idx, val_idx in rskf.split(X, y_bins):\n","    model.fit(X.iloc[train_idx], y.iloc[train_idx])\n","    rskf_scores.append(mean_squared_error(y.iloc[val_idx], model.predict(X.iloc[val_idx])))\n","print(f\"[4] Rep Stratified CV (5 Folds x 3 Reps) MSE : {np.mean(rskf_scores):.4f}\")\n","\n","# 11. Leave-One-Out Cross-Validation (LOOCV)\n","loo = LeaveOneOut()\n","loo_scores = []\n","for train_idx, val_idx in loo.split(X):\n","    model.fit(X.iloc[train_idx], y.iloc[train_idx])\n","    loo_scores.append(mean_squared_error(y.iloc[val_idx], model.predict(X.iloc[val_idx])))\n","print(f\"[5] Leave-One-Out CV (LOOCV) Mean MSE        : {np.mean(loo_scores):.4f}\")\n","\n","# 12. Leave-p-Out Cross-Validation (LpOCV)\n","# Scaled safely to p=2 on a subset of 15 samples to circumvent polynomial combination bottlenecks\n","lpo = LeavePOut(p=2)\n","lpo_scores = []\n","X_sub, y_sub = X.iloc[:15], y.iloc[:15]\n","for train_idx, val_idx in lpo.split(X_sub):\n","    model.fit(X_sub.iloc[train_idx], y_sub.iloc[train_idx])\n","    lpo_scores.append(mean_squared_error(y_sub.iloc[val_idx], model.predict(X_sub.iloc[val_idx])))\n","print(f\"[6] Leave-p-Out CV (p=2, on 15 samples) MSE  : {np.mean(lpo_scores):.4f}\")\n","\n","# 13. Shuffle Split Cross-Validation (Monte Carlo)\n","ss = ShuffleSplit(n_splits=5, test_size=0.20, random_state=42)\n","ss_scores = []\n","for train_idx, val_idx in ss.split(X):\n","    model.fit(X.iloc[train_idx], y.iloc[train_idx])\n","    ss_scores.append(mean_squared_error(y.iloc[val_idx], model.predict(X.iloc[val_idx])))\n","print(f\"[7] Shuffle Split CV Mean MSE                : {np.mean(ss_scores):.4f}\")\n","\n","# 14. Stratified Shuffle Split\n","sss = StratifiedShuffleSplit(n_splits=5, test_size=0.20, random_state=42)\n","sss_scores = []\n","for train_idx, val_idx in sss.split(X, y_bins):\n","    model.fit(X.iloc[train_idx], y.iloc[train_idx])\n","    sss_scores.append(mean_squared_error(y.iloc[val_idx], model.predict(X.iloc[val_idx])))\n","print(f\"[8] Stratified Shuffle Split CV Mean MSE     : {np.mean(sss_scores):.4f}\\n\")\n","\n","\n","# ==============================================================================\n","# PART C: ADVANCED SPLITTING TECHNIQUES (Group-Based \u0026 Bootstrap)\n","# ==============================================================================\n","print(\"--- PART C: GROUP-BASED \u0026 BOOTSTRAP VARIATIONS ---\")\n","\n","# 15. Group K-Fold Cross Validation\n","gkf = GroupKFold(n_splits=5)\n","gkf_scores = []\n","for train_idx, val_idx in gkf.split(X, y, groups):\n","    model.fit(X.iloc[train_idx], y.iloc[train_idx])\n","    gkf_scores.append(mean_squared_error(y.iloc[val_idx], model.predict(X.iloc[val_idx])))\n","print(f\"[1] Group K-Fold CV Mean MSE                 : {np.mean(gkf_scores):.4f}\")\n","\n","# 16. Stratified Group K-Fold Cross Validation\n","sgkf = StratifiedGroupKFold(n_splits=5)\n","sgkf_scores = []\n","for train_idx, val_idx in sgkf.split(X, y_bins, groups):\n","    model.fit(X.iloc[train_idx], y.iloc[train_idx])\n","    sgkf_scores.append(mean_squared_error(y.iloc[val_idx], model.predict(X.iloc[val_idx])))\n","print(f\"[2] Stratified Group K-Fold CV Mean MSE      : {np.mean(sgkf_scores):.4f}\")\n","\n","# 17. Bootstrap Sampling with Out-of-Bag (OOB) Evaluation\n","n_samples = len(df)\n","boot_scores = []\n","for iteration in range(5):\n","    np.random.seed(iteration)\n","    train_idx = np.random.choice(n_samples, size=n_samples, replace=True)\n","    oob_idx = np.array(list(set(range(n_samples)) - set(train_idx)))\n","\n","    model.fit(X.iloc[train_idx], y.iloc[train_idx])\n","    boot_scores.append(mean_squared_error(y.iloc[oob_idx], model.predict(X.iloc[oob_idx])))\n","print(f\"[3] Bootstrap Out-of-Bag Evaluation Mean MSE : {np.mean(boot_scores):.4f}\")\n","print(\"=\" * 80)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"G3AXbnM1Vg7t"},"outputs":[{"name":"stdout","output_type":"stream","text":["Training shape: (3794, 241), Test shape: (1020, 241)\n","Starting Cross-Validation...\n"]},{"name":"stderr","output_type":"stream","text":["/usr/local/lib/python3.12/dist-packages/xgboost/training.py:200: UserWarning: [12:26:51] WARNING: /__w/xgboo